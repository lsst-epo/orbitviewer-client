# Runtime environment. Anything other than "prod" renders the viewport debug overlay.
ENVIRONMENT=dev

# Public origin for this client; used as metadataBase for canonical + OG URLs.
ROOT_DOMAIN=https://orbitviewer.app

# Craft CMS GraphQL endpoint (pages, elements, categories, tours, globals).
API_URL=https://api.orbitviewer.app/api

# Hasura federated query endpoints (MPC orbital data + object search).
HASURA_GRAPHQL=https://hasura-proxy-688095955960.us-central1.run.app/v1/graphql
HASURA_URL=https://hasura-proxy-688095955960.us-central1.run.app/api/rest

# Shared secrets with Craft. Required by /api/revalidate and /api/preview.
# Left blank intentionally -- supply real values locally and in deploy config.
CRAFT_REVALIDATE_SECRET_TOKEN=
CRAFT_SECRET_TOKEN=
