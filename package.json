{
  "name": "orbitviewer-client",
  "version": "0.1.0",
  "author": "Rubin EPO",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/lsst-epo/orbitviewer-client"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -p 8080",
    "bs": "next build && next start -p 3000",
    "lint": "npm-run-all lint:*",
    "lint:js": "prettier --check \"**/*.{js,jsx,ts,tsx}\" && eslint -c .eslintrc.cjs \"**/*.{js,jsx,ts,tsx}\"",
    "lint:css": "stylelint --config .stylelintrc.js \"**/*.css\"",
    "fix": "npm-run-all fix:js fix:css",
    "fix:js": "prettier --write \"**/*.{js,jsx,ts,tsx}\" && eslint -c .eslintrc.cjs \"**/*.{js,jsx,ts,tsx}\" --fix",
    "fix:css": "stylelint --config .stylelintrc.js \"**/*.css\" --fix",
    "codegen": "graphql-codegen --config codegen.ts",
    "typecheck": "tsc --noEmit"
  },
  "browserslist": [
    "defaults",
    "not IE 11"
  ],
  "dependencies": {
    "@react-three/drei": "10.7.8",
    "@react-three/fiber": "9.7.0",
    "@rubin-epo/epo-react-lib": "^3.0.4",
    "@rubin-epo/epo-widget-lib": "^2.2.1",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@urql/core": "^6.0.3",
    "@urql/next": "^2.0.1",
    "clsx": "^2.1.1",
    "graphql": "^16.14.2",
    "gsap": "^3.15.0",
    "i18next": "23",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-resources-to-backend": "^1.2.3",
    "lodash": "^4.17.21",
    "next": "16.3.5",
    "next-intl": "^4.14.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-i18next": "13",
    "server-only": "^0.0.1",
    "sharp": "^0.34.4",
    "three": "0.181.0",
    "urql": "^5.0.1",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^7.4.1",
    "@graphql-codegen/client-preset": "^6.1.3",
    "@rushstack/eslint-patch": "^1.11.0",
    "@types/lodash": "^4.17.7",
    "@types/node": "^24.7.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "0.181.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "^8.57.1",
    "eslint-config-next": "14",
    "eslint-config-prettier": "^9.1.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-n": "^16.6.2",
    "eslint-plugin-promise": "^6.6.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-unused-imports": "^4.1.4",
    "jiti": "^2.7.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.6.2",
    "raw-loader": "^4.0.2",
    "stylelint": "^16.25.0",
    "stylelint-config-css-modules": "^4.4.0",
    "stylelint-config-recess-order": "^7.4.0",
    "stylelint-config-standard": "^39.0.1",
    "stylelint-order": "^8.0.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "packageManager": "yarn@1.22.22",
  "resolutions": {
    "eslint-plugin-react-hooks": "^4.6.2"
  }
}
