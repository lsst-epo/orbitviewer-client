{
  "name": "orbitviewer-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "static": "yarn static:build",
    "static:build": "next build --turbopack",
    "start": "next start -p 8080",
    "bs": "yarn build && next start -p 3000",
    "lint": "yarn lint:js && yarn lint:css",
    "lint:js": "node --import ./scripts/lint-register.ts ./node_modules/eslint/bin/eslint.js .",
    "lint:css": "stylelint \"**/*.css\"",
    "fix": "yarn fix:js && yarn fix:css",
    "fix:js": "node --import ./scripts/lint-register.ts ./node_modules/eslint/bin/eslint.js . --fix",
    "fix:css": "stylelint \"**/*.css\" --fix",
    "typecheck": "tsc --noEmit",
    "codegen": "graphql-codegen --config codegen.ts"
  },
  "dependencies": {
    "@react-three/drei": "10.7.8",
    "@react-three/fiber": "9.7.0",
    "@rubin-epo/epo-react-lib": "^2.9.3",
    "@rubin-epo/epo-widget-lib": "^1.1.1",
    "graphql": "^16.11.0",
    "i18next": "^23.16.8",
    "i18next-browser-languagedetector": "^8.0.0",
    "i18next-resources-to-backend": "^1.2.1",
    "next": "16.3.0",
    "next-intl": "^4.1.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-i18next": "^15.7.3",
    "sanitize-html": "^2.17.0",
    "server-only": "0.0.1",
    "three": "0.181.0"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@graphql-codegen/cli": "^5.0.2",
    "@graphql-codegen/client-preset": "^4.3.3",
    "@next/env": "16.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/sanitize-html": "^2.16.0",
    "@types/three": "^0.181.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.0",
    "eslint-plugin-unused-imports": "^4.1.4",
    "jiti": "^2.4.2",
    "prettier": "^3.6.0",
    "raw-loader": "^4.0.2",
    "stylelint": "^16.0.0",
    "stylelint-config-css-modules": "^4.4.0",
    "stylelint-config-standard": "^37.0.0",
    "three-stdlib": "^2.36.0",
    "typescript": "7.0.2",
    "@typescript/legacy": "npm:@typescript/typescript6@^6.0.2"
  },
  "babel": {
    "presets": [
      "next/babel"
    ]
  }
}
